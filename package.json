{
  "name": "@syncended/dsh-retry",
  "version": "0.1.1",
  "description": "Configurable automatic retries and interrupted-session recovery for DeepSeek Harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "llm",
    "retry"
  ],
  "author": "syncended",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syncended/deepseek-harness-retry.git"
  },
  "bugs": {
    "url": "https://github.com/syncended/deepseek-harness-retry/issues"
  },
  "homepage": "https://github.com/syncended/deepseek-harness-retry#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-retry": "^0.1.0-rc.7 || ^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7 || ^0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-retry": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@types/node": "^20",
    "typescript": "^5.9.3"
  }
}
